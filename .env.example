# Copie este arquivo pra ".env.local" (mesma pasta, raiz do projeto) e
# preencha com as chaves do seu projeto Firebase.
#
# Onde achar essas chaves: console.firebase.google.com → seu projeto →
# ⚙️ Configurações do projeto → seção "Seus apps" → app Web → "Config" do SDK.
#
# Essas chaves são públicas por design (vão pro bundle JS que roda no
# navegador) — quem protege os dados de fato são as regras de segurança do
# Firestore (cada usuário só acessa /usuarios/{seu-próprio-uid}/**), não o
# sigilo dessas chaves.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
